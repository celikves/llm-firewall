OPENAI_API_KEY=sk-your-key-here
SEMANTIC_THRESHOLD=0.85
JUDGE_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# RAG API (default 8010 — 8001 is often taken by Docker on macOS)
RAG_API_PORT=8010

# Chroma RAG
CHROMA_PERSIST_DIR=chroma_db
RAG_COLLECTION_CLEAN=rag_clean
RAG_COLLECTION_POISONED=rag_poisoned
RAG_TOP_K=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
# RAG_TRACE_ENABLED=false forces traces off (bulk eval). Unset = follow LANGSMITH_TRACING.
RAG_TRACE_ENABLED=

# LangSmith tracing (EU). When LANGSMITH_TRACING=true, RAG spans are sent automatically.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=llm-firewall
